# Required for the "Ask AI About Me" chatbot
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the built-in portfolio chatbot context
# Leave unset to use src/data/chatContext.js (recommended)
# VITE_OPENAI_CONTEXT=

# Optional: EmailJS contact form (site contact CTA uses mailto by default)
# VITE_SERVICE_ID=
# VITE_TEMPLATE_ID=
# VITE_USER_ID=
